  <property name="styleSheet">
   <string notr="true">QPushButton {
    background: #073642;
    color: #BECDCD;
    border: 1px solid #586E75;
    border-radius: 5px;
    padding: 5px 9px;
}
QPushButton:hover {
    border-color: #268BD2;
}
QPushButton:focus {
    border: 2px solid #268BD2;
}
QPushButton:disabled {
    color: #586E75;
    border-color: #073642;
}
QLineEdit, QListWidget, QTextBrowser {
    background: #073642;
    color: #BECDCD;
    border: 1px solid #586E75;
    border-radius: 5px;
    padding: 4px 7px;
}
QLineEdit:focus, QListWidget:focus, QTextBrowser:focus {
    border: 2px solid #268BD2;
}
QPushButton[tutorialTab="true"] {
    color: #BECDCD;
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 5px 10px;
}
QPushButton[tutorialTab="true"]:checked {
    color: #268BD2;
    border-bottom: 2px solid #268BD2;
}
QPushButton[tutorialTab="true"]:hover, QPushButton[tutorialTab="true"]:focus {
    background: #073642;
}
QFrame[tutorialPanel="true"] {
    background: #002B36;
    border: 1px solid #073642;
    border-radius: 8px;
}
QListWidget {
    outline: 0;
}
QListWidget::item {
    padding: 5px;
}
QListWidget::item:selected {
    color: #BECDCD;
    background: #002B36;
    border-left: 2px solid #268BD2;
}
</string>
