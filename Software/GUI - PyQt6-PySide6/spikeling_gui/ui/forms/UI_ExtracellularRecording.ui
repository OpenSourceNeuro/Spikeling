 <class>ExtracellularRecording</class>
 <widget class="QWidget" name="ExtracellularRecording">
  <layout class="QVBoxLayout" name="rootLayout">
   <item>
    <widget class="QTabWidget" name="tabs">
     <widget class="QWidget" name="recording">
      <attribute name="title"><string>Recording</string></attribute>
      <layout class="QVBoxLayout" name="recordingLayout">
       <item>
        <layout class="QHBoxLayout" name="openLayout">
         <item><widget class="QPushButton" name="openButton"><property name="text"><string>Open recording…</string></property></widget></item>
         <item><widget class="QLabel" name="statusLabel">
          <property name="text"><string>Open a session manifest or an extracellular CSV.</string></property>
          <property name="wordWrap"><bool>true</bool></property>
          <property name="textFormat"><enum>Qt::TextFormat::PlainText</enum></property>
          <property name="textInteractionFlags"><set>Qt::TextInteractionFlag::TextSelectableByMouse</set></property>
         </widget></item>
        </layout>
       </item>
       <item><widget class="QPlainTextEdit" name="metadata">
        <property name="readOnly"><bool>true</bool></property>
        <property name="maximumHeight"><number>155</number></property>
        <property name="placeholderText"><string>Recording metadata</string></property>
