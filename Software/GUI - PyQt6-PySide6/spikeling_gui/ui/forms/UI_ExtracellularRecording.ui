  <property name="styleSheet">
   <string notr="true">QPushButton {
    background: #073642;
    color: #BECDCD;
    border: 1px solid #586E75;
    border-radius: 5px;
    padding: 5px 9px;
}
QPushButton:hover {
    border-color: #268BD2;
}
QPushButton:focus {
    border: 2px solid #268BD2;
}
QPushButton:disabled {
    color: #586E75;
    border-color: #073642;
}
QLineEdit, QComboBox, QPlainTextEdit {
    background: #073642;
    color: #BECDCD;
    border: 1px solid #586E75;
    border-radius: 5px;
    padding: 4px 7px;
}
QLineEdit:focus, QComboBox:focus {
    border: 2px solid #268BD2;
}
QTableWidget { background: #002B36; color: #BECDCD; gridline-color: #073642; }
QLabel#recordingGuide, QLabel#processingGuide, QLabel#detectionGuide, QLabel#spectrumGuide {
    font-size: 10pt;
}
QPushButton[analysisTab="true"] {
    color: #586E75;
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 5px 10px;
}
QPushButton[analysisTab="true"]:checked {
    color: #268BD2;
    border-bottom: 2px solid #268BD2;
}
QPushButton[analysisTab="true"]:hover, QPushButton[analysisTab="true"]:focus {
    background: #073642;
}
QFrame[analysisPanel="true"] {
    background: #002B36;
    border: 1px solid #073642;
    border-radius: 8px;
}
QLabel[analysisStatus="true"] {
    color: #586E75;
}
</string>
