                       <item>
                        <widget class="QTabWidget" name="Settings_SignalColours_tabWidget">
                         <property name="styleSheet">
                          <string notr="true">/* All tabs */
QTabBar::tab {
    background-color: rgb(7, 54, 66);
    color: rgb(190, 205, 205);

    font-size: 10pt;
    padding: 8px 14px;

    border: 1px solid rgb(88, 110, 117);
}

/* Selected tab */
QTabBar::tab:selected {
    background-color: rgb(0, 153, 176);
    color: rgb(253, 246, 227);

    font-weight: bold;
}

/* Hover over an unselected tab */
QTabBar::tab:!selected:hover {
    background-color: rgb(22, 70, 83);
}

/* Content area border */
QTabWidget::pane {
    border: 1px solid rgb(88, 110, 117);
}</string>
                         </property>
