                                  <item>
                                   <widget class="QLabel" name="About_OriginTitle">
                                    <property name="font">
                                     <font>
                                      <pointsize>14</pointsize>
                                      <bold>true</bold>
                                     </font>
                                    </property>
                                    <property name="text">
                                     <string>The idea behind the project</string>
                                    </property>
                                    <property name="wordWrap">
                                     <bool>true</bool>
                                    </property>
                                   </widget>
                                  </item>
                                  <item>
                                   <widget class="QLabel" name="About_OriginLabel">
                                    <property name="font">
                                     <font>
                                      <pointsize>11</pointsize>
                                      <bold>false</bold>
                                     </font>
                                    </property>
                                    <property name="text">
                                     <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Spikeling grew out of a teaching challenge. Students could learn how neurons fire and process information in lectures, yet opportunities to design and carry out their own electrophysiology experiments were harder to provide. &lt;/p&gt;&lt;p&gt;Early teaching sessions included a TReND in Africa summer school for graduate students in Gombe, Nigeria, and practical classes for undergraduate and master’s students at the University of Sussex.&lt;/p&gt;&lt;p&gt;Spikeling has since grown into a complete open-source teaching platform. The original idea still guides the project: give students a neuron model they can experiment with and let them use the results to answer their own questions.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                                    </property>
                                    <property name="wordWrap">
                                     <bool>true</bool>
                                    </property>
                                   </widget>
