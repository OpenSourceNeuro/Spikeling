                               <property name="styleSheet">
                                <string notr="true">QPushButton#StimulusGenerator_Display_pushButton,
QPushButton#StimulusGenerator_Save_pushButton {
    background-color: rgb(7, 54, 66);
    color: rgb(190, 205, 205);
    border: 1px solid rgb(131, 148, 150);
    border-radius: 6px;
    padding: 4px 12px;
}

QPushButton#StimulusGenerator_Display_pushButton:enabled:hover,
QPushButton#StimulusGenerator_Save_pushButton:enabled:hover {
    border-color: rgb(0, 153, 176);
}

QPushButton#StimulusGenerator_Display_pushButton:focus,
QPushButton#StimulusGenerator_Save_pushButton:focus {
    border-color: rgb(0, 153, 176);
}

QPushButton#StimulusGenerator_Display_pushButton:enabled:pressed,
QPushButton#StimulusGenerator_Save_pushButton:enabled:pressed {
    background-color: rgb(0, 30, 38);
    border-color: rgb(42, 161, 152);
}

QPushButton#StimulusGenerator_Display_pushButton:disabled,
QPushButton#StimulusGenerator_Save_pushButton:disabled {
    background-color: rgb(0, 43, 54);
    color: rgb(88, 110, 117);
    border-color: rgb(88, 110, 117);
}</string>
