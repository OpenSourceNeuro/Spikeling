                             <string notr="true">QPushButton {
    background-color: rgb(7, 54, 66);
    color: rgb(190, 205, 205);

    border: 1px solid rgb(123, 157, 163);

    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;

    padding: 6px 18px;

    font-family: &quot;Segoe UI&quot;;
    font-size: 11pt;
    font-weight: 400;
}

QPushButton:hover {
    background-color: rgb(22, 70, 83);
}

QPushButton:checked {
    background-color: rgb(0, 153, 176);
    color: rgb(253, 246, 227);
    border-color: rgb(74, 190, 204);
    font-weight: 700;
}

QPushButton:checked:hover {
    background-color: rgb(0, 174, 196);
}

QPushButton:pressed {
    background-color: rgb(0, 127, 146);
}

QPushButton:focus {
    border-color: rgb(253, 246, 227);
}</string>
