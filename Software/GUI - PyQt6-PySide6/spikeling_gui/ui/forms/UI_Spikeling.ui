&lt;p align=&quot;center&quot;&gt;&lt;span style=&quot;font-size:48pt;&quot;&gt;Spikeling &lt;/span&gt;&lt;span style=&quot;font-size:16pt;&quot;&gt;{version}&lt;/span&gt;&lt;/p&gt;
&lt;p align=&quot;center&quot;&gt;&lt;span style=&quot;font-size:16pt;&quot;&gt;A hardware implementation of spiking neurons for neuroscience teaching and outreach&lt;/span&gt;&lt;/p&gt;
&lt;p align=&quot;right&quot;&gt;&lt;span style=&quot;font-weight:696;&quot;&gt;Conceived by M.J.Y. Zimmermann&lt;/span&gt;&lt;/p&gt;
&lt;p align=&quot;right&quot;&gt;&lt;span style=&quot;font-weight:696;&quot;&gt;Developed with A. Koumoundourou, L. Zanetti &amp;amp; P. Rignanese&lt;/span&gt;&lt;/p&gt;
&lt;p align=&quot;right&quot;&gt;&lt;span style=&quot;font-weight:696;&quot;&gt;Based on an original idea from T. Baden&lt;/span&gt;&lt;/p&gt;
&lt;/body&gt;&lt;/html&gt;</string>
