QWidget#page_GitHub QPushButton {
    background-color: palette(button);
    color: palette(button-text);
    border: 1px solid palette(mid);
    border-radius: 6px;
    padding: 5px 12px;
    font-weight: 600;
}

QWidget#page_GitHub QPushButton:hover:enabled,
QWidget#page_GitHub QPushButton:focus:enabled {
    border: 1px solid palette(highlight);
}

QWidget#page_GitHub QPushButton#GitHub_Check_pushButton:enabled {
    border: 1px solid palette(highlight);
}

QWidget#page_GitHub QPushButton#GitHub_Check_pushButton:hover:enabled,
QWidget#page_GitHub QPushButton#GitHub_Check_pushButton:focus:enabled {
    border: 2px solid palette(highlight);
    padding: 4px 11px;
}

QWidget#page_GitHub QPushButton#GitHub_Install_pushButton:enabled {
    background-color: palette(highlight);
    color: palette(highlighted-text);
    border: 1px solid palette(highlight);
}

QWidget#page_GitHub QPushButton#GitHub_Install_pushButton:hover:enabled,
QWidget#page_GitHub QPushButton#GitHub_Install_pushButton:focus:enabled {
    border: 2px solid palette(highlighted-text);
    padding: 4px 11px;
}

QWidget#page_GitHub QPushButton:pressed:enabled {
    padding-top: 6px;
    padding-bottom: 4px;
}

QWidget#page_GitHub QPushButton:disabled {
    background-color: palette(window);
    color: palette(mid);
    border: 1px solid palette(mid);
}



