                   <widget class="QWidget" name="DataAnalysis_sweepsPage">
                    <property name="styleSheet">
                     <string notr="true">QLabel#DataAnalysis_Cycles_heading, QLabel#DataAnalysis_Sweeps_tracesHeading,
                    QLabel#DataAnalysis_Summary_heading {
                        font-size: 12pt;
                        font-weight: 700;
                    }
                    QLabel#DataAnalysis_Summary_contextLabel {
                        color: #586E75;
                    }
                    QFrame#DataAnalysis_Sweeps_plotPane {
                        background: #002B36;
                        border: 1px solid #073642;
                        border-radius: 8px;
                    }
                    QPushButton {
                        background: #073642;
                        color: #BECDCD;
                        border: 1px solid #586E75;
                        border-radius: 5px;
                        padding: 5px 9px;
                    }
                    QPushButton:hover {
                        border-color: #268BD2;
                    }
                    QPushButton:focus {
                        border: 2px solid #268BD2;
                    }
                    QPushButton:disabled {
                        color: #586E75;
                        border-color: #073642;
                    }
                    QLineEdit, QComboBox {
                        background: #073642;
                        color: #BECDCD;
                        border: 1px solid #586E75;
                        border-radius: 5px;
                        padding: 4px 7px;
                    }
                    QLineEdit:focus, QComboBox:focus {
                        border: 2px solid #268BD2;
                    }
					QFrame#DataAnalysis_plotPanel, QFrame#DataAnalysis_Cycles_Plot_frame {
    					background: #002B36;
    					border: 1px solid #073642;
   				        border-radius: 8px;
					}</string>
