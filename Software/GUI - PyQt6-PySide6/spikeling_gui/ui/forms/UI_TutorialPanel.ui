    <property name="styleSheet">
      <string notr="true">QDialog#TutorialPanel { background-color: rgb(0, 43, 54); color: rgb(190, 205, 205); font-family: "Segoe UI"; font-size: 10pt; }
QDialog#TutorialPanel QFrame#headerCard, QDialog#TutorialPanel QFrame#footerCard { background-color: rgb(7, 54, 66); border: 1px solid rgb(88, 110, 117); border-radius: 8px; }
QDialog#TutorialPanel QFrame#reflectionCard, QDialog#TutorialPanel QFrame#statusCard { background-color: rgb(7, 54, 66); border: 1px solid rgb(88, 110, 117); border-radius: 6px; }
QDialog#TutorialPanel QScrollArea#stepScrollArea, QDialog#TutorialPanel QWidget#stepScrollContent { background-color: transparent; border: none; }
QDialog#TutorialPanel QLabel { color: rgb(190, 205, 205); background-color: transparent; border: none; padding: 0; }
QDialog#TutorialPanel QLabel#tutorialTitle { color: rgb(238, 232, 213); font-size: 13pt; font-weight: 700; }
QDialog#TutorialPanel QLabel#stepCount { color: rgb(190, 205, 205); font-size: 9pt; }
QDialog#TutorialPanel QLabel#stepTitle { color: rgb(238, 232, 213); font-size: 12pt; font-weight: 700; }
QDialog#TutorialPanel QLabel#phaseLabel { color: rgb(38, 139, 210); font-size: 10pt; font-weight: 600; }
QDialog#TutorialPanel QLabel#instructionText, QDialog#TutorialPanel QLabel#reflectionPrompt { font-size: 10pt; }
QDialog#TutorialPanel QLabel#targetLabel { color: rgb(190, 205, 205); font-size: 9pt; }
QDialog#TutorialPanel QLabel#hintLabel { color: rgb(238, 232, 213); font-size: 9pt; }
QDialog#TutorialPanel QLabel#stateLabel { color: rgb(190, 205, 205); font-size: 9pt; }
QDialog#TutorialPanel QPlainTextEdit#reflectionEdit { background-color: rgb(0, 30, 38); color: rgb(238, 232, 213); border: 1px solid rgb(88, 110, 117); border-radius: 6px; padding: 8px; selection-background-color: rgb(38, 139, 210); font-size: 10pt; }
QDialog#TutorialPanel QPlainTextEdit#reflectionEdit:focus { border: 1px solid rgb(38, 139, 210); }
QDialog#TutorialPanel QCheckBox#attestationCheck { background-color: transparent; color: rgb(190, 205, 205); font-size: 10pt; spacing: 8px; }
QDialog#TutorialPanel QCheckBox#attestationCheck::indicator { width: 15px; height: 15px; border: 1px solid rgb(190, 205, 205); border-radius: 3px; background-color: rgb(0, 30, 38); }
QDialog#TutorialPanel QCheckBox#attestationCheck::indicator:checked { background-color: rgb(38, 139, 210); border: 1px solid rgb(38, 139, 210); image: none; }
QDialog#TutorialPanel QPushButton { background-color: rgb(0, 43, 54); color: rgb(238, 232, 213); border: 1px solid rgb(88, 110, 117); border-radius: 6px; padding: 6px 11px; font-size: 10pt; font-weight: 600; min-height: 20px; }
QDialog#TutorialPanel QPushButton:hover:enabled { background-color: rgb(7, 54, 66); border: 1px solid rgb(38, 139, 210); }
QDialog#TutorialPanel QPushButton:pressed { background-color: rgb(0, 30, 38); }
QDialog#TutorialPanel QPushButton:disabled { color: rgb(88, 110, 117); border: 1px solid rgb(88, 110, 117); }
QDialog#TutorialPanel QPushButton#nextButton { background-color: rgb(38, 139, 210); color: rgb(253, 246, 227); border: 1px solid rgb(38, 139, 210); font-weight: 700; }
QDialog#TutorialPanel QPushButton#nextButton:hover:enabled { background-color: rgb(42, 161, 152); border-color: rgb(42, 161, 152); }
QDialog#TutorialPanel QPushButton#nextButton:disabled { background-color: rgb(7, 54, 66); color: rgb(88, 110, 117); border-color: rgb(88, 110, 117); }
QDialog#TutorialPanel QProgressBar#progressBar { background-color: rgb(0, 30, 38); border: none; border-radius: 4px; min-height: 7px; max-height: 7px; text-align: center; }
QDialog#TutorialPanel QProgressBar#progressBar::chunk { background-color: rgb(38, 139, 210); border-radius: 4px; }
QDialog#TutorialPanel QScrollBar:vertical { background-color: rgb(0, 43, 54); width: 9px; margin: 0; }
QDialog#TutorialPanel QScrollBar::handle:vertical { background-color: rgb(88, 110, 117); min-height: 20px; border-radius: 4px; }
QDialog#TutorialPanel QScrollBar::add-line:vertical, QDialog#TutorialPanel QScrollBar::sub-line:vertical { height: 0; }
QDialog#TutorialPanel QScrollBar::add-page:vertical, QDialog#TutorialPanel QScrollBar::sub-page:vertical { background: transparent; }

QDialog#TutorialPanel QPushButton#titleCloseButton { background-color: transparent; color: rgb(190, 205, 205); border: none; border-radius: 5px; padding: 0; font-size: 20pt; font-weight: 700; min-height: 0; }
QDialog#TutorialPanel QPushButton#titleCloseButton:hover { background-color: rgb(0, 30, 38); color: rgb(238, 232, 213); }
QDialog#TutorialPanel QWidget#resizeGripHost { background-color: transparent; border: none; }
</string>
