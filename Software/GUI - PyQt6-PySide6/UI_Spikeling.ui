                                 <number>0</number>
                                </property>
                                <item>
                                 <widget class="QLabel" name="b_text">
                                  <property name="text">
                                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;The parameter &lt;span style=&quot; font-size:12pt; font-weight:600;&quot;&gt;b&lt;/span&gt; describes the sensitivity of the recovery variable &lt;span style=&quot; font-weight:600;&quot;&gt;u &lt;/span&gt;to the subthreshold fluctuations of the membrane potential v. Greater values couple&lt;span style=&quot; font-weight:600;&quot;&gt; v&lt;/span&gt; and&lt;span style=&quot; font-weight:600;&quot;&gt; u&lt;/span&gt; more strongly resulting in possible sub-threshold oscillations and low-threshold spiking dynamics. &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; text-decoration: underline;&quot;&gt;A typical value is &lt;/span&gt;&lt;span style=&quot; font-weight:600; text-decoration: underline;&quot;&gt;b &lt;/span&gt;&lt;span style=&quot; text-decoration: underline;&quot;&gt;= 0.2&lt;/span&gt;. &lt;/p&gt;&lt;p&gt;The case &lt;span style=&quot; font-weight:600;&quot;&gt;b&lt;/span&gt; &amp;lt; &lt;span style=&quot; font-weight:600;&quot;&gt;a&lt;/span&gt;(&lt;span style=&quot; font-weight:600;&quot;&gt;b&lt;/span&gt; &amp;gt; &lt;span style=&quot; font-weight:600;&quot;&gt;a&lt;/span&gt;) corresponds to saddle-node (Andronov–Hopf) bifurcation of the resting state.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                                  </property>
                                  <property name="alignment">
                                   <set>Qt::AlignBottom|Qt::AlignJustify</set>
                                  </property>
                                  <property name="wordWrap">
                                   <bool>true</bool>
                                  </property>
                                 </widget>
                                </item>
                               </layout>
                              </widget>
                             </item>
                            </layout>
                           </widget>
                          </item>
