               <widget class="QWidget" name="page_701">
                <layout class="QHBoxLayout" name="horizontalLayout_124">
                 <property name="spacing">
                  <number>0</number>
                 </property>
                 <property name="leftMargin">
                  <number>20</number>
                 </property>
                 <property name="topMargin">
                  <number>5</number>
