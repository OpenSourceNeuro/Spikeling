                                  <property name="text">
                                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-size:9pt;&quot;&gt;The parameter &lt;/span&gt;&lt;span style=&quot; font-size:12pt; font-weight:600;&quot;&gt;d&lt;/span&gt;&lt;span style=&quot; font-size:9pt;&quot;&gt; describes after-spike reset of the recovery variable &lt;/span&gt;&lt;span style=&quot; font-size:9pt; font-weight:600;&quot;&gt;u&lt;/span&gt;&lt;span style=&quot; font-size:9pt;&quot;&gt; caused by slow high-threshold Na+ and K+ conductances.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:9pt; text-decoration: underline;&quot;&gt;A typical value is &lt;/span&gt;&lt;span style=&quot; font-size:9pt; font-weight:600; text-decoration: underline;&quot;&gt;d&lt;/span&gt;&lt;span style=&quot; font-size:9pt; text-decoration: underline;&quot;&gt; = 2&lt;/span&gt;&lt;span style=&quot; font-size:9pt;&quot;&gt;.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                                  </property>
