               <widget class="QWidget" name="page_601">
                <layout class="QHBoxLayout" name="horizontalLayout_119">
                 <item>
                  <widget class="QFrame" name="frame_11">
                   <property name="frameShape">
                    <enum>QFrame::StyledPanel</enum>
                   </property>
