{
  "name": "@opensource-neuro/spikeling-web-emulator",
  "version": "0.1.0",
  "private": true,
  "description": "Responsive, accessible, numerically validated worker-based neuronal emulator with scientific oscilloscope, dual synapses and private desktop-compatible recording for Open Source Neuro Spikeling.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "fixtures": "python3 tools/reference/generate_desktop_golden.py",
    "fixtures:check": "python3 tools/reference/generate_desktop_golden.py --check",
    "dev": "node tools/serve.mjs",
    "build": "node tools/build.mjs",
    "test": "node --test tests/*.test.ts",
    "test:model": "node --test tests/model.test.ts",
    "test:parity": "node --test tests/parity.test.ts",
    "test:engine": "node --test tests/engine.test.ts",
    "test:worker": "node --test tests/worker.test.ts",
    "test:performance": "node --test tests/performance.test.ts",
    "test:visualisation": "node --test tests/visualisation.test.ts tests/oscilloscope.test.ts",
    "test:controls": "node --test tests/controls.test.ts tests/custom-stimulus.test.ts",
    "test:synapses": "node --test tests/synapses.test.ts",
    "test:recording": "node --test tests/recording-csv.test.ts tests/recording.test.ts",
    "test:accessibility": "node --test tests/accessibility.test.ts tests/interface.test.ts",
    "test:wordpress": "node --test tests/wordpress.test.ts tests/production-build.test.ts",
    "test:integration": "node --test tests/integration-qa.test.ts",
    "qa:integration": "node tools/integration-qa.mjs",
    "verify": "npm run fixtures:check && npm run qa:integration && npm test"
  },
  "keywords": [
    "izhikevich",
    "neuroscience",
    "open-hardware",
    "spikeling"
  ]
}
