		)
		(uuid "bc34311b-663e-4f3c-bbc0-d045bcb57a9a")
	)
	(text "Steps the protected battery voltage up to a regulated 5 V rail for stand-alone operation. \nAlso includes the control network that allows the boost path to be enabled or inhibited depending on system power conditions."
		(exclude_from_sim no)
		(at 436.88 45.72 0)
		(effects
