	(text "Spike Buttons"
		(exclude_from_sim no)
		(at 477.774 170.18 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left top)
		)
		(uuid "04950993-c0c7-48e2-8c0c-12bf88b6e8b5")
	)
	(text "Board power tree, source selection, battery management, control electronics, analogue acquisition and external signal interfaces. \nDistributes power from USB or battery operation and routes the front-panel controls, analogue readout and output signals to the main controller."
		(exclude_from_sim no)
		(at 38.1 27.94 0)
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.254)
				(bold yes)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "0caae5ec-83c8-49eb-9233-157d7be37a99")
	)
	(text "LiPo Battery Charger\n"
		(exclude_from_sim no)
		(at 330.2 38.1 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left top)
		)
		(uuid "10058c10-be60-4dbf-a622-a876c43de6a4")
	)
	(text "Synapse 1"
		(exclude_from_sim no)
		(at 25.4 170.434 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left top)
		)
		(uuid "205a8225-d564-4a45-9d20-7a0da16f55b5")
	)
	(text "This section converts the photodiode current into a measurable voltage\n using an analogue front-end with gain and filtering. \nIt provides the controller with a conditioned light-response signal."
		(exclude_from_sim no)
		(at 172.72 332.74 0)
		(effects
			(font
				(size 1 1)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "21605fff-f8e2-41d5-a4ed-72375b767706")
	)
	(text "This section acquires the front-panel control associated \nwith membrane voltage behaviour. \nIt provides a stable analogue control value to the ADC\nso the firmware can adjust the neuron model accordingly."
		(exclude_from_sim no)
		(at 81.28 332.74 0)
		(effects
			(font
				(size 1 1)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "243bf6e6-f45c-483a-9a2c-6ac79239ca1e")
	)
	(text "Combines the available 5 V sources into the main +5V rail \nwhile preventing reverse current between them. \nForms the primary 5 V distribution node for the rest of the board.\nIsolates USB power from the battery-boosted supply."
		(exclude_from_sim no)
		(at 114.3 43.18 0)
		(effects
			(font
				(size 1 1)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "275fad7f-6793-412a-a311-8885dbe8f7f3")
	)
	(text "This section drives the external synaptic output connector \nwith the buffered output signal generated by the system. \nIt provides a protected, low-impedance interface for patching \nthe board to external equipment or other units."
		(exclude_from_sim no)
		(at 533.4 241.3 0)
		(effects
			(font
				(size 1 1)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "2b2932dd-9ae5-4760-bd5f-4698ef79b28f")
	)
	(text "ESP32 Buttons"
		(exclude_from_sim no)
		(at 254 243.84 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left top)
		)
		(uuid "3d186dcb-d59b-476e-bbae-7aaee262d67e")
	)
	(text "This section converts controller-generated digital values into analogue voltages \nand buffers them before they are sent to external outputs. \nIt provides controlled low-impedance analogue drive for stimulus and related output signals."
		(exclude_from_sim no)
		(at 203.2 167.64 0)
		(effects
			(font
				(size 1 1)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "3ee233a5-a1e7-4061-8ba3-d037f84c81c8")
	)
	(text "Converts the main +5V rail into the regulated +3.3V digital supply \nused by the controller and digital peripherals. \nProvides the main low-voltage logic rail for the board."
		(exclude_from_sim no)
		(at 238.76 42.926 0)
		(effects
			(font
				(size 1 1)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "445a39ce-cb06-4903-a23d-a2d4bfee50ed")
	)
	(text "Charges the single-cell LiPo battery from USB power using a dedicated charger IC. \nSets the charge current, stabilises the charger supply.\nGenerates the battery charge node used by the protected battery path."
		(exclude_from_sim no)
		(at 335.28 43.18 0)
		(effects
			(font
				(size 1 1)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "46b70802-8a5f-4e75-b780-797fd53ec1b0")
	)
	(text "This section is the main digital controller of the board. \nIt handles:\n	USB communication\n	Peripheral control\n	Signal generation \n	Data acquisition  \n	System coordination."
		(exclude_from_sim no)
		(at 309.88 241.3 0)
		(effects
			(font
				(size 1 1)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "50d26436-be4e-498b-810c-17fe84cd69c5")
	)
	(text "This section conditions the first synapse input from the external connector \nbefore it is measured or interpreted by the controller. \nIt includes the protection and biasing needed for robust front-panel patch use."
		(exclude_from_sim no)
		(at 63.5 167.64 0)
		(effects
			(font
				(size 1 1)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "560e08c3-8b9d-4641-8713-1dd32b90fbe4")
	)
	(text "This section digitises the analogue control voltages and sensor signals used by the system. \nIt provides the controller with measured values from the front-panel potentiometers and analogue inputs."
		(exclude_from_sim no)
		(at 386.08 167.64 0)
		(effects
			(font
				(size 1 1)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "6869caf8-aafe-4dac-b06c-81a85cf4b38d")
	)
